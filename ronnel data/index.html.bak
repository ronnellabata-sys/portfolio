<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="author" content="Ronnel Labata">
  <meta name="description" content="Ronnel Labata is an IT specialist, educator, and digital solutions consultant helping organizations turn ideas, learning needs, and daily operations into clear digital systems.">
  <meta property="og:title" content="Ronnel Labata | Digital Solutions That Work">
  <meta property="og:description" content="Technology, educational solutions, and organized digital support for schools, teams, and growing organizations.">
  <meta property="og:type" content="website">
  <!-- TODO: Add og:url and a dedicated social preview image after the portfolio is published. -->
  <meta name="theme-color" content="#050816">
  <link rel="preload" as="image" href="Live.jpg">
  <title>Ronnel Labata | IT, Education &amp; Digital Solutions</title>
  <style>
    :root{
      --bg:#050816;
      --bg-soft:#080d1d;
      --surface:#0b1226;
      --surface-high:#101933;
      --line:#1b2945;
      --line-bright:#2b4766;
      --text:#f8fafc;
      --muted:#a9b6cb;
      --cyan:#22d3ee;
      --cyan-light:#67e8f9;
      --violet:#9b6cff;
      --violet-light:#c084fc;
      --shadow:0 24px 70px rgba(0,0,0,.34);
      --radius:18px;
      --container:min(1180px,calc(100% - 48px));
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;overflow-x:hidden;background:var(--bg);color:var(--text);font:15px/1.7 Inter,"Segoe UI",Arial,sans-serif}
    body:before{content:"";position:fixed;inset:0;z-index:-2;pointer-events:none;background:radial-gradient(circle at 84% 12%,rgba(155,108,255,.09),transparent 27%),radial-gradient(circle at 12% 28%,rgba(34,211,238,.06),transparent 23%),linear-gradient(rgba(34,211,238,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(34,211,238,.018) 1px,transparent 1px);background-size:auto,auto,48px 48px,48px 48px}
    body.modal-open{overflow:hidden}
    img{display:block;max-width:100%}
    a{color:inherit;text-decoration:none}
    button,input,textarea{font:inherit}
    button{color:inherit}
    [hidden]{display:none!important}
    ::selection{background:rgba(34,211,238,.28);color:white}
    :focus-visible{outline:2px solid var(--cyan);outline-offset:4px}
    .container{width:var(--container);margin-inline:auto}
    .skip-link{position:fixed;left:18px;top:-70px;z-index:200;padding:10px 14px;border-radius:8px;background:var(--cyan);color:#03101b;font-weight:800}.skip-link:focus{top:18px}

    .site-header{position:sticky;top:0;z-index:100;border-bottom:1px solid rgba(111,139,177,.14);background:rgba(5,8,22,.88);backdrop-filter:blur(18px)}
    .nav-shell{min-height:72px;display:flex;align-items:center;gap:24px}
    .brand{display:flex;align-items:center;gap:11px;min-width:max-content}
    .brand-mark{position:relative;width:38px;height:38px;display:grid;place-items:center;border:1px solid rgba(34,211,238,.48);border-radius:11px;background:linear-gradient(145deg,#102446,#10122f);color:var(--cyan-light);font-weight:900;font-size:11px;letter-spacing:-.08em;box-shadow:inset 0 1px rgba(255,255,255,.09),0 0 24px rgba(34,211,238,.1)}
    .brand-mark:after{content:"";position:absolute;right:-3px;bottom:5px;width:6px;height:6px;border-radius:50%;background:var(--cyan);box-shadow:0 0 12px var(--cyan)}
    .brand-copy{display:flex;flex-direction:column;line-height:1.1}.brand-copy strong{font-size:12px}.brand-copy small{margin-top:3px;color:#7f91ae;font-size:7px;font-weight:800;letter-spacing:.16em;text-transform:uppercase}
    .nav-links{display:flex;align-items:center;justify-content:center;gap:25px;margin-left:auto}
    .nav-links a{position:relative;padding:25px 0;color:#9aaac0;font-size:11px;font-weight:650}
    .nav-links a:after{content:"";position:absolute;left:0;right:100%;bottom:17px;height:1px;background:linear-gradient(90deg,var(--cyan),var(--violet));transition:right .24s}
    .nav-links a:hover,.nav-links a.active{color:white}.nav-links a:hover:after,.nav-links a.active:after{right:0}
    .nav-cta{display:inline-flex;align-items:center;justify-content:center;padding:9px 13px;border:1px solid #354665;border-radius:8px;background:#0c1428;color:#dce6f3;font-size:10px;font-weight:800;transition:.22s}.nav-cta:hover{border-color:var(--violet);transform:translateY(-1px)}
    .menu-toggle{display:none;width:42px;height:42px;margin-left:auto;border:1px solid #2a3b58;border-radius:9px;background:#0b1325;cursor:pointer}.menu-toggle span,.menu-toggle:before,.menu-toggle:after{content:"";display:block;width:18px;height:1px;margin:5px auto;background:#d9e5f2;transition:.22s}.menu-toggle[aria-expanded="true"] span{opacity:0}.menu-toggle[aria-expanded="true"]:before{transform:translateY(6px) rotate(45deg)}.menu-toggle[aria-expanded="true"]:after{transform:translateY(-6px) rotate(-45deg)}

    .section{position:relative;padding:112px 0;border-top:1px solid rgba(111,139,177,.09)}
    .section:nth-of-type(even){background:linear-gradient(180deg,rgba(8,13,29,.56),rgba(5,8,22,.2))}
    .section-label{display:inline-flex;align-items:center;gap:9px;color:var(--cyan);font-size:9px;font-weight:850;letter-spacing:.18em;text-transform:uppercase}.section-label:before{content:"";width:24px;height:1px;background:var(--cyan)}
    .section-heading{max-width:760px;margin:11px 0 0;font-size:clamp(35px,5vw,62px);line-height:1.02;letter-spacing:-.052em}.section-heading .cyan{color:var(--cyan-light)}.section-heading .violet{color:var(--violet-light)}
    .section-intro{max-width:710px;margin:18px 0 0;color:var(--muted);font-size:15px}
    .button-row{display:flex;gap:11px;flex-wrap:wrap}
    .button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border:1px solid #405273;border-radius:9px;background:#0b1427;color:#edf4fc;font-size:11px;font-weight:800;transition:transform .22s,border-color .22s,background .22s,box-shadow .22s}.button:hover{transform:translateY(-2px);border-color:#7086aa}.button.primary{border-color:transparent;background:linear-gradient(105deg,var(--cyan),#67e8f9 48%,var(--violet));color:#04101c;box-shadow:0 12px 34px rgba(34,211,238,.15)}.button.primary:hover{box-shadow:0 16px 42px rgba(34,211,238,.24)}.button.ghost{background:rgba(10,19,38,.72)}
    .chip-row{display:flex;gap:7px;flex-wrap:wrap}.chip{display:inline-flex;padding:5px 8px;border:1px solid #2a3a58;border-radius:999px;background:#070d1b;color:#b8c5d6;font-size:9px}
    .panel{border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(145deg,rgba(16,25,51,.88),rgba(8,14,30,.94));box-shadow:inset 0 1px rgba(255,255,255,.035)}

    /* Hero */
    .hero-section{min-height:760px;padding:78px 0 70px;display:grid;align-items:center;overflow:hidden}
    .hero-section:after{content:"";position:absolute;width:640px;height:640px;right:-190px;bottom:-350px;z-index:-1;border-radius:50%;background:radial-gradient(circle,rgba(155,108,255,.18),transparent 67%)}
    .hero-grid{display:grid;grid-template-columns:1.02fr .98fr;gap:76px;align-items:center}
    .availability{display:inline-flex;align-items:center;gap:8px;padding:7px 11px;border:1px solid rgba(72,213,174,.28);border-radius:999px;background:rgba(38,167,132,.08);color:#9af3d4;font-size:9px;font-weight:850;letter-spacing:.13em;text-transform:uppercase}.availability:before{content:"";width:7px;height:7px;border-radius:50%;background:#46e3ad;box-shadow:0 0 10px #46e3ad}
    .hero-name{margin:22px 0 6px;color:#d4deeb;font-size:15px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
    .hero-title{margin:0;font-size:clamp(55px,7.6vw,92px);line-height:.83;letter-spacing:-.07em}.hero-title span{display:block;background:linear-gradient(95deg,var(--cyan-light),var(--violet-light) 54%,white);-webkit-background-clip:text;background-clip:text;color:transparent}
    .hero-role{margin:23px 0 11px;color:#dbe5f2;font-size:clamp(17px,2vw,24px);font-weight:750;line-height:1.25}
    .hero-copy>p{max-width:640px;margin:0;color:var(--muted);font-size:15px}
    .hero-copy .button-row{margin-top:27px}
    .hero-benefits{display:flex;gap:16px;flex-wrap:wrap;margin-top:32px;padding-top:19px;border-top:1px solid #18243c;color:#93a4bb;font-size:10px}.hero-benefits span{display:flex;align-items:center;gap:7px}.hero-benefits span:before{content:"";width:4px;height:4px;border-radius:50%;background:var(--cyan)}
    .proof-console{position:relative;padding:13px;border:1px solid #3e4b78;border-radius:20px;background:linear-gradient(145deg,#10172f,#080d1c);box-shadow:var(--shadow),0 0 60px rgba(155,108,255,.1);transform:perspective(1200px) rotateY(-3deg)}
    .proof-console:before{content:"";position:absolute;inset:-1px;z-index:-1;border-radius:20px;background:linear-gradient(135deg,rgba(34,211,238,.6),transparent 36%,rgba(155,108,255,.55));filter:blur(8px);opacity:.38}
    .console-bar{display:flex;align-items:center;justify-content:space-between;padding:5px 4px 11px;color:#7e92ad;font:700 8px/1 monospace;letter-spacing:.11em;text-transform:uppercase}.console-bar b{color:var(--cyan)}
    .console-screen{position:relative;min-height:370px;overflow:hidden;border:1px solid #263858;border-radius:13px;background:#030812}
    .console-screen>img{width:100%;height:370px;object-fit:contain;background:linear-gradient(135deg,#06111f,#0a1326)}
    .profile-screen{min-height:470px;background:#000}
    .profile-screen>img{height:470px;object-fit:contain;object-position:center;background:#000;filter:saturate(.94) contrast(1.04)}
    .profile-screen:after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,transparent 0 48%,rgba(103,232,249,.09) 50%,transparent 52%);background-size:100% 18px;mix-blend-mode:screen;opacity:.28}
    .console-status{position:absolute;left:14px;right:14px;bottom:14px;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 12px;border:1px solid rgba(34,211,238,.35);border-radius:8px;background:rgba(3,8,18,.86);backdrop-filter:blur(10px);font-size:9px}.console-status strong{color:white}.console-status span{color:var(--cyan)}
    .console-footer{display:grid;grid-template-columns:1.2fr .8fr;gap:9px;margin-top:9px}.console-note{padding:12px;border:1px solid #253451;border-radius:10px;background:#080f20}.console-note small{display:block;color:#6f83a0;font-size:7px;letter-spacing:.1em;text-transform:uppercase}.console-note strong{display:block;margin-top:4px;font-size:10px}.console-data{display:grid;grid-template-columns:repeat(2,1fr);gap:5px}.console-data span{padding:8px;border:1px solid #253451;border-radius:7px;color:#a9b7ca;font:700 7px/1.3 monospace;text-align:center}
    /* Live.jpg is the user-supplied profile visual; project evidence remains in the case-study section below. */

    /* About and audience */
    .about-layout{display:grid;grid-template-columns:.9fr 1.1fr;gap:70px;align-items:start}
    .about-copy p{max-width:560px;color:var(--muted)}
    .value-stack{display:grid;gap:13px}.value-card{position:relative;padding:23px 70px 23px 24px}.value-card .index{position:absolute;right:22px;top:16px;color:#24334d;font:900 28px/1 monospace}.value-card h3{margin:0 0 7px;font-size:17px}.value-card p{margin:0;color:#9faec2;font-size:12px}.value-card ul{display:grid;gap:4px;margin:14px 0 0;padding:0;list-style:none;color:#aebdd0;font-size:10px}.value-card li:before{content:"•";margin-right:8px;color:var(--cyan)}
    .audience-panel{display:grid;grid-template-columns:.72fr 1.28fr;gap:28px;margin-top:34px;padding:26px}.audience-panel h3{margin:6px 0 0;font-size:22px}.audience-panel p{margin:0;color:var(--muted);font-size:12px}.audience-benefits{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.audience-benefits span{padding:10px 12px;border:1px solid #223450;border-radius:8px;background:#080f20;color:#bdc9d9;font-size:10px}.audience-benefits span:before{content:"✓";margin-right:8px;color:var(--cyan)}

    /* Services */
    .split-heading{display:grid;grid-template-columns:1.1fr .9fr;gap:70px;align-items:end;margin-bottom:42px}.split-heading .section-intro{margin:0 0 7px}
    .services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
    .service-card{position:relative;min-height:270px;padding:24px;overflow:hidden;transition:.25s}.service-card:after{content:"";position:absolute;left:24px;right:24px;bottom:0;height:2px;background:linear-gradient(90deg,transparent,var(--cyan),var(--violet),transparent);transform:scaleX(0);transition:.25s}.service-card:hover{transform:translateY(-5px);border-color:#3d5578;box-shadow:0 20px 48px rgba(0,0,0,.28)}.service-card:hover:after{transform:scaleX(1)}
    .service-top{display:flex;align-items:center;justify-content:space-between}.service-icon{width:42px;height:42px;display:grid;place-items:center;border:1px solid rgba(34,211,238,.28);border-radius:10px;background:rgba(34,211,238,.06);color:var(--cyan-light);font:900 9px monospace}.service-index{color:#202e47;font:900 24px monospace}.service-card h3{margin:23px 0 8px;font-size:16px}.service-card>p{margin:0;color:#9eacc0;font-size:11px}.deliverables{display:flex;gap:6px;flex-wrap:wrap;margin-top:17px}.deliverables span{padding:4px 7px;border:1px solid #253652;border-radius:5px;color:#8fa1b8;font-size:8px}

    /* Projects */
    .projects-list{display:grid;gap:26px;margin-top:44px}
    .case-study{display:grid;grid-template-columns:1fr 1fr;overflow:hidden}.case-study:nth-child(even) .case-media{order:2}
    .case-media{position:relative;min-height:500px;display:grid;place-items:center;padding:28px;overflow:hidden;background:radial-gradient(circle at 50% 40%,rgba(34,211,238,.11),transparent 45%),#060c1a}
    .case-image-button{position:relative;display:block;width:100%;padding:0;border:0;background:transparent;color:inherit;cursor:zoom-in}
    .case-media img{width:100%;height:440px;object-fit:contain;border:1px solid #263b59;border-radius:12px;background:#050a14;box-shadow:0 24px 50px rgba(0,0,0,.36);transition:border-color .24s,transform .24s,box-shadow .24s}
    .case-image-button:hover img,.case-image-button:focus-visible img{border-color:var(--cyan);transform:translateY(-2px);box-shadow:0 26px 55px rgba(0,0,0,.42),0 0 26px rgba(34,211,238,.1)}
    .media-action{position:absolute;right:14px;bottom:14px;pointer-events:none}
    .case-content{display:flex;flex-direction:column;justify-content:center;padding:40px}.case-id{color:#7185a3;font:800 8px monospace;letter-spacing:.14em;text-transform:uppercase}.case-content h3{margin:9px 0 7px;font-size:clamp(28px,3.4vw,44px);line-height:1.04;letter-spacing:-.035em}.case-overview{margin:0;color:#a9b7ca;font-size:12px}.case-facts{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin:24px 0}.case-fact{padding-top:13px;border-top:1px solid #263650}.case-fact strong{display:block;margin-bottom:5px;color:#7187a7;font-size:8px;letter-spacing:.11em;text-transform:uppercase}.case-fact p{margin:0;color:#bdc8d8;font-size:10px}.case-result{margin:0 0 20px;padding:13px 15px;border-left:2px solid var(--violet);background:rgba(155,108,255,.065);color:#c7d1df;font-size:10px}.case-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:auto}

    /* Capabilities and workflow */
    .capability-layout{display:grid;grid-template-columns:.76fr 1.24fr;gap:34px;margin-top:44px}.capability-overview{padding:27px}.capability-overview h3{margin:0 0 9px;font-size:20px}.capability-overview p{color:var(--muted);font-size:12px}.capability-note{margin-top:25px;padding:14px;border-left:2px solid var(--cyan);background:rgba(34,211,238,.05);color:#b8c6d7;font-size:10px}
    .tool-groups{display:grid;gap:11px}.tool-group{display:grid;grid-template-columns:170px 1fr;gap:18px;align-items:center;padding:17px}.tool-group h3{margin:0;font-size:11px}.tool-group small{display:block;margin-top:3px;color:#7185a3;font-size:7px;letter-spacing:.08em;text-transform:uppercase}.tool-list{display:flex;gap:7px;flex-wrap:wrap}.tool{display:inline-flex;align-items:center;gap:6px;padding:6px 8px;border:1px solid #263754;border-radius:6px;background:#080f20;color:#bdc9d8;font-size:9px}.tool img{width:16px;height:16px;object-fit:contain}
    .workflow-heading{margin-top:62px}.workflow-heading .section-heading{font-size:clamp(30px,4vw,48px)}.workflow-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:24px}.workflow-step{padding:21px}.workflow-number{width:34px;height:34px;display:grid;place-items:center;border:1px solid rgba(155,108,255,.55);border-radius:50%;color:var(--violet-light);font:800 9px monospace}.workflow-step h3{margin:18px 0 6px;font-size:14px}.workflow-step p{margin:0;color:#98a8bd;font-size:10px}

    /* Experience */
    .experience-intro{display:grid;grid-template-columns:1fr .7fr;gap:60px;align-items:end}.experience-intro .section-intro{margin:0}
    .experience-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:42px}.experience-card{padding:24px}.experience-card small{color:var(--cyan);font-size:8px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.experience-card h3{margin:9px 0 14px;font-size:18px}.experience-card ul{display:grid;gap:8px;margin:0;padding:0;list-style:none;color:#aebbcf;font-size:10px}.experience-card li:before{content:"•";margin-right:8px;color:var(--violet-light)}
    .commitment{margin-top:24px;padding:24px 28px;border:1px solid #2b3a5a;border-radius:14px;background:linear-gradient(100deg,rgba(34,211,238,.055),rgba(155,108,255,.07));color:#c8d3e2}.commitment strong{display:block;margin-bottom:6px;color:white}.commitment p{margin:0;font-size:12px}
    /* TODO: Add verified organizations and dates if Ronnel supplies them; these cards intentionally describe experience areas rather than employment history. */

    /* Contact */
    .contact-shell{display:grid;grid-template-columns:1.1fr .9fr;gap:34px;padding:44px;background:radial-gradient(circle at 90% 20%,rgba(155,108,255,.14),transparent 34%),linear-gradient(145deg,#101a35,#080e20)}
    .contact-shell h2{max-width:660px;margin:9px 0 17px;font-size:clamp(42px,6vw,72px);line-height:.94;letter-spacing:-.055em}.contact-shell h2 .cyan{color:var(--cyan-light)}.contact-shell h2 .violet{color:var(--violet-light)}.contact-shell p{max-width:620px;color:#aebcd0}.contact-shell .button-row{margin-top:24px}
    .contact-card{align-self:center;padding:24px}.contact-card h3{margin:0 0 16px;font-size:13px}.contact-list{display:grid;gap:9px}.contact-item{display:grid;grid-template-columns:70px 1fr;gap:12px;padding:10px 0;border-bottom:1px solid #22324d}.contact-item:last-child{border-bottom:0}.contact-item b{color:#7187a5;font-size:8px;letter-spacing:.1em;text-transform:uppercase}.contact-item a,.contact-item span{color:#d5deea;font-size:10px;overflow-wrap:anywhere}
    /* TODO: Add verified phone, LinkedIn, GitHub, Upwork, OnlineJobs.ph, and published portfolio URL when supplied. */

    .site-footer{padding:26px 0;border-top:1px solid #18243c;color:#788ba6;font-size:10px}.footer-inner{display:flex;align-items:center;justify-content:space-between;gap:20px}.footer-inner a{color:#b6c4d6}.footer-role{margin-left:7px;color:#566b89}

    /* Gallery */
    .gallery-modal{position:fixed;inset:0;z-index:300;display:grid;place-items:center;padding:20px;background:rgba(2,5,13,.91);backdrop-filter:blur(14px)}
    .gallery-dialog{width:min(1040px,100%);max-height:92vh;display:flex;flex-direction:column;overflow:hidden;border:1px solid #355476;border-radius:18px;background:#071020;box-shadow:0 35px 100px rgba(0,0,0,.65)}
    .gallery-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;padding:19px 20px;border-bottom:1px solid #21344f}.gallery-head small{display:block;color:var(--cyan);font-size:8px;letter-spacing:.12em;text-transform:uppercase}.gallery-head h2{margin:4px 0 0;font-size:19px}.gallery-close{width:38px;height:38px;flex:0 0 38px;border:1px solid #354967;border-radius:50%;background:#0b162b;cursor:pointer}.gallery-close:hover{border-color:var(--cyan)}
    .gallery-stage{position:relative;min-height:0;display:grid;grid-template-columns:50px minmax(0,1fr) 50px;align-items:center;gap:12px;padding:20px;background:#030812}.gallery-stage figure{min-width:0;margin:0;text-align:center}.gallery-stage img{width:100%;height:min(64vh,650px);object-fit:contain;border-radius:10px;background:#020611}.gallery-stage figcaption{margin-top:10px;color:#8295ae;font:700 9px monospace}.gallery-nav{width:42px;height:42px;border:1px solid #35506c;border-radius:50%;background:#0a1729;color:var(--cyan-light);font-size:21px;cursor:pointer}.gallery-nav:hover{border-color:var(--cyan);background:#0d2338}
    .gallery-foot{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:15px 20px;border-top:1px solid #21344f}.gallery-foot p{margin:0;color:#91a3bb;font-size:10px}.gallery-foot a{color:var(--cyan-light);font-size:10px;font-weight:800}

    .reveal{opacity:0;transform:translateY(18px);transition:opacity .65s ease,transform .65s ease}.reveal.visible,.hero-section .reveal{opacity:1;transform:none}

    @media(max-width:1050px){
      :root{--container:min(100% - 38px,900px)}
      .nav-links{gap:16px}.nav-links a{font-size:10px}.nav-cta{display:none}
      .hero-grid{grid-template-columns:1fr 1fr;gap:34px}.hero-title{font-size:62px}.console-screen,.console-screen>img{min-height:0;height:320px}.profile-screen,.profile-screen>img{height:390px}
      .about-layout,.split-heading,.capability-layout,.experience-intro{grid-template-columns:1fr;gap:34px}
      .services-grid{grid-template-columns:repeat(2,1fr)}
      .case-study{grid-template-columns:1fr}.case-study:nth-child(even) .case-media{order:0}.case-media{min-height:430px}.case-media img{height:380px}
      .workflow-grid{grid-template-columns:repeat(2,1fr)}
      .experience-grid{grid-template-columns:1fr 1fr}.experience-card:last-child{grid-column:1/-1}
    }

    @media(max-width:820px){
      :root{--container:min(100% - 30px,680px)}
      .site-header{background:rgba(5,8,22,.96)}.nav-shell{min-height:66px}.menu-toggle{display:block}
      .nav-links{position:absolute;left:15px;right:15px;top:66px;display:none;align-items:stretch;gap:0;padding:10px;border:1px solid #273854;border-radius:0 0 13px 13px;background:#080f20;box-shadow:0 24px 50px rgba(0,0,0,.5)}.nav-links.open{display:flex;flex-direction:column}.nav-links a{padding:11px 12px;border-radius:7px}.nav-links a:hover,.nav-links a.active{background:#0d1930}.nav-links a:after{display:none}
      .hero-section{padding-top:55px}.hero-grid{grid-template-columns:1fr;gap:42px}.hero-copy{order:1}.proof-console{order:2;max-width:620px;width:100%;margin:auto;transform:none}.hero-title{font-size:clamp(55px,12vw,78px)}.profile-screen,.profile-screen>img{height:500px}
      .about-layout{gap:40px}.audience-panel{grid-template-columns:1fr}.audience-benefits{grid-template-columns:1fr}
      .section{padding:86px 0}.case-content{padding:30px}.case-facts{grid-template-columns:1fr}.case-media{padding:18px}
      .tool-group{grid-template-columns:1fr}.contact-shell{grid-template-columns:1fr;padding:30px}
    }

    @media(max-width:560px){
      :root{--container:min(100% - 24px,520px);--radius:14px}
      body{font-size:14px}.brand-copy small{display:none}.section{padding:72px 0}.section-heading{font-size:39px}.section-intro{font-size:14px}
      .hero-section{min-height:auto;padding:44px 0 64px}.hero-name{font-size:12px}.hero-title{font-size:50px}.hero-role{font-size:18px}.hero-copy>p{font-size:14px}.hero-benefits{display:grid;gap:8px}
      .button-row{display:grid;grid-template-columns:1fr}.button{width:100%}
      .proof-console{padding:9px}.console-screen,.console-screen>img{height:250px}.profile-screen,.profile-screen>img{height:340px}.console-footer{grid-template-columns:1fr}.console-data{display:none}.console-status{left:9px;right:9px;bottom:9px}
      .services-grid,.workflow-grid,.experience-grid{grid-template-columns:1fr}.service-card{min-height:auto}.experience-card:last-child{grid-column:auto}
      .case-media{min-height:300px;padding:12px}.case-media img{height:280px}.case-content{padding:24px 19px}.case-content h3{font-size:30px}.media-action{right:10px;bottom:10px;width:auto}
      .tool-group{padding:15px}.contact-shell{padding:24px 19px}.contact-shell h2{font-size:43px}.footer-inner{align-items:flex-start;flex-direction:column}
      .gallery-modal{padding:7px}.gallery-dialog{max-height:97vh}.gallery-stage{grid-template-columns:38px minmax(0,1fr) 38px;gap:5px;padding:12px 7px}.gallery-nav{width:34px;height:34px}.gallery-stage img{height:58vh}.gallery-foot{align-items:flex-start;flex-direction:column}.gallery-foot a{padding:8px 0}
    }

    @media(prefers-reduced-motion:reduce){
      html{scroll-behavior:auto}.reveal,.button,.service-card,.service-card:after,.nav-links a:after{transition:none}.reveal{opacity:1;transform:none}
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <header class="site-header">
    <div class="container nav-shell">
      <a class="brand" href="#home" aria-label="Ronnel Labata home">
        <span class="brand-mark" aria-hidden="true">RL</span>
        <span class="brand-copy"><strong>Ronnel Labata</strong><small>Digital Solutions</small></span>
      </a>
      <nav class="nav-links" id="primary-navigation" aria-label="Primary navigation">
        <a class="active" href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#services">Services</a>
        <a href="#projects">Projects</a>
        <a href="#capabilities">Capabilities</a>
        <a href="#experience">Experience</a>
        <a href="#contact">Contact</a>
      </nav>
      <a class="nav-cta" href="mailto:ronnel.labata@gmail.com?subject=Project%20Inquiry%20for%20Ronnel%20Labata">Let’s connect ↗</a>
      <button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-controls="primary-navigation" aria-expanded="false"><span></span></button>
    </div>
  </header>

  <main id="main-content">
    <section class="hero-section section" id="home" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy reveal">
          <div class="availability">Available for remote collaboration</div>
          <div class="hero-name">Ronnel Labata</div>
          <h1 class="hero-title" id="hero-title"><span>Digital</span> solutions that work.</h1>
          <h2 class="hero-role">IT Specialist, Educator, and Digital Solutions Consultant</h2>
          <p>I help schools, educators, teams, and growing organizations turn ideas, learning needs, and everyday operations into clear digital systems. My work combines technology, educational design, documentation, and organized support.</p>
          <div class="button-row">
            <a class="button primary" href="#projects">Explore project work ↗</a>
            <a class="button ghost" href="mailto:ronnel.labata@gmail.com?subject=Project%20Inquiry%20for%20Ronnel%20Labata">Start a conversation</a>
            <!-- TODO: Add a résumé button only after a verified PDF is placed in the project. -->
          </div>
          <div class="hero-benefits" aria-label="Professional focus">
            <span>Technology development</span>
            <span>Digital learning</span>
            <span>Virtual assistance</span>
            <span>Workflow improvement</span>
          </div>
        </div>

        <div class="proof-console reveal" aria-label="Ronnel Labata profile visual">
          <div class="console-bar"><span>Portfolio command center</span><b>System online</b></div>
          <div class="console-screen profile-screen">
            <img src="Live.jpg" width="1200" height="1200" fetchpriority="high" decoding="async" alt="Futuristic cyan command interface used as Ronnel Labata's portfolio profile visual">
            <div class="console-status"><strong>Ronnel Labata</strong><span>IT • Education • Digital Solutions</span></div>
          </div>
          <div class="console-footer">
            <div class="console-note"><small>Featured work: GenSpe + SpeakSmart</small><strong>Real supplied project images and documented case studies</strong></div>
            <div class="console-data" aria-hidden="true"><span>EDTECH</span><span>MOBILE UI</span><span>CONTENT</span><span>WORKFLOW</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="about" aria-labelledby="about-title">
      <div class="container">
        <div class="about-layout">
          <div class="about-copy reveal">
            <div class="section-label">About me</div>
            <h2 class="section-heading" id="about-title">Bridging technology, learning, and <span class="cyan">digital operations.</span></h2>
            <p>My work sits at the intersection of technical implementation, instructional design, content development, and dependable administrative support. I focus on turning complex requirements into systems, resources, and workflows that people can understand and use.</p>
            <p>I work with care, clear documentation, and practical next steps—whether the need is a website, educational resource, organized workflow, or reliable digital assistance.</p>
          </div>
          <div class="value-stack reveal">
            <article class="value-card panel"><span class="index">01</span><h3>Technology that solves a clear problem</h3><p>I build accessible digital experiences and translate requirements into practical solutions.</p><ul><li>Responsive websites and interfaces</li><li>Technical support and implementation</li><li>Digital tools selected for the actual need</li></ul></article>
            <article class="value-card panel"><span class="index">02</span><h3>Learning experiences designed for people</h3><p>I combine educational knowledge with technology to create structured, approachable learning materials.</p><ul><li>Digital learning resources</li><li>Instructional and curriculum support</li><li>Mobile-first educational content</li></ul></article>
            <article class="value-card panel"><span class="index">03</span><h3>Operations that stay organized</h3><p>I support businesses and teams with documentation, research, task coordination, and workflow improvement.</p><ul><li>Reliable administrative support</li><li>Clear documentation and reporting</li><li>AI-assisted productivity workflows</li></ul></article>
          </div>
        </div>

        <div class="audience-panel panel reveal">
          <div><div class="section-label">Who I help</div><h3>Organizations that need clearer digital systems.</h3></div>
          <div><p>I can support educators, schools, small businesses, remote teams, and project owners who need practical technology, organized information, or dependable digital assistance.</p><div class="audience-benefits"><span>Better-organized information</span><span>Clearer learning materials</span><span>More consistent documentation</span><span>Smoother project coordination</span></div></div>
        </div>
      </div>
    </section>

    <section class="section" id="services" aria-labelledby="services-title">
      <div class="container">
        <div class="split-heading reveal">
          <div><div class="section-label">Services</div><h2 class="section-heading" id="services-title">Support designed around <span class="cyan">what needs</span> to move <span class="violet">forward.</span></h2></div>
          <p class="section-intro">A focused range of services for schools, educators, growing businesses, and teams that need clearer digital systems.</p>
        </div>

        <div class="services-grid reveal">
          <article class="service-card panel"><div class="service-top"><span class="service-icon">WD</span><span class="service-index">01</span></div><h3>Website Development</h3><p>Responsive, accessible websites that present your organization, services, and ideas with clarity.</p><div class="deliverables"><span>Responsive pages</span><span>Content structure</span><span>Interface support</span></div></article>
          <article class="service-card panel"><div class="service-top"><span class="service-icon">DL</span><span class="service-index">02</span></div><h3>Digital Learning Solutions</h3><p>Learning materials, mobile learning concepts, LMS content, and technology-supported educational experiences.</p><div class="deliverables"><span>Learning resources</span><span>Content organization</span><span>Mobile learning</span></div></article>
          <article class="service-card panel"><div class="service-top"><span class="service-icon">AI</span><span class="service-index">03</span></div><h3>AI Workflow Automation</h3><p>AI-assisted workflows and connected tools that reduce repetitive work and support faster decisions.</p><div class="deliverables"><span>Process mapping</span><span>Prompt workflows</span><span>Task support</span></div></article>
          <article class="service-card panel"><div class="service-top"><span class="service-icon">VA</span><span class="service-index">04</span></div><h3>Virtual Assistance</h3><p>Reliable remote support for research, scheduling, documentation, file organization, and recurring digital tasks.</p><div class="deliverables"><span>Research</span><span>Documentation</span><span>Task coordination</span></div></article>
          <article class="service-card panel"><div class="service-top"><span class="service-icon">TC</span><span class="service-index">05</span></div><h3>Technology Consulting</h3><p>Practical guidance for selecting, organizing, and implementing technology that fits your goals and resources.</p><div class="deliverables"><span>Needs review</span><span>Tool selection</span><span>Implementation plan</span></div></article>
          <article class="service-card panel"><div class="service-top"><span class="service-icon">CD</span><span class="service-index">06</span></div><h3>Content &amp; Documentation</h3><p>Clear educational, business, presentation, and digital content shaped to the audience, purpose, and delivery platform.</p><div class="deliverables"><span>Presentations</span><span>Guides</span><span>Structured content</span></div></article>
        </div>
      </div>
    </section>

    <section class="section" id="projects" aria-labelledby="projects-title">
      <div class="container">
        <div class="section-label">Selected project work</div>
        <h2 class="section-heading" id="projects-title">Proof through <span class="cyan">real project images</span> and documented decisions.</h2>
        <p class="section-intro">These case studies use the project screenshots and public posts already supplied. Each project is labeled accurately and avoids unsupported client or performance claims.</p>

        <div class="projects-list">
          <article class="case-study panel reveal">
            <div class="case-media">
              <button class="case-image-button gallery-trigger" type="button" data-project="genspe" aria-label="Open the GenSpe project image gallery">
                <img src="images/genspe-1.png" width="1514" height="1039" loading="lazy" alt="GenSpe educational application interface showing mobile learning screens">
                <span class="button primary media-action" aria-hidden="true">View gallery ↗</span>
              </button>
            </div>
            <div class="case-content">
              <div class="case-id">Case study 01 • Academic project</div>
              <h3>GenSpe Learning Application</h3>
              <p class="case-overview">An educational mobile application concept designed to organize specialized learning content into an approachable, interactive experience.</p>
              <div class="case-facts">
                <div class="case-fact"><strong>Objective</strong><p>Make learning content easier to access, understand, and navigate through a structured mobile interface.</p></div>
                <div class="case-fact"><strong>Project contribution</strong><p>Application concept, learning-content organization, interface planning, and portfolio documentation.</p></div>
                <div class="case-fact"><strong>Process</strong><p>Structured the learning flow, organized interface states, and documented the experience through supplied project screens.</p></div>
                <div class="case-fact"><strong>Deliverables</strong><p>Mobile UI concept, educational content structure, navigation flow, and image-based case study.</p></div>
              </div>
              <!-- TODO: Confirm the exact technology stack and individual team responsibilities for GenSpe. -->
              <div class="chip-row"><span class="chip">Mobile UI</span><span class="chip">Education content</span><span class="chip">UX structure</span><span class="chip">Digital learning</span></div>
              <p class="case-result"><strong>Documented output:</strong> three supplied project images presented through an accessible gallery with a verified public Facebook post.</p>
              <div class="case-actions"><button class="button gallery-trigger" type="button" data-project="genspe">View project gallery</button><a class="button ghost" href="https://www.facebook.com/share/p/1BW5AodikY/" target="_blank" rel="noopener noreferrer">View original post ↗</a></div>
            </div>
          </article>

          <article class="case-study panel reveal">
            <div class="case-media">
              <button class="case-image-button gallery-trigger" type="button" data-project="speaksmart" aria-label="Open the SpeakSmart project image gallery">
                <img src="images/speak-app.png" width="2000" height="2000" loading="lazy" alt="SpeakSmart communication learning application project presentation">
                <span class="button primary media-action" aria-hidden="true">View gallery ↗</span>
              </button>
            </div>
            <div class="case-content">
              <div class="case-id">Case study 02 • Academic project</div>
              <h3>SpeakSmart Mobile Learning Application</h3>
              <p class="case-overview">A mobile-first educational concept supporting communication and vocabulary practice through approachable, guided learning activities.</p>
              <div class="case-facts">
                <div class="case-fact"><strong>Objective</strong><p>Create a clearer digital learning experience for communication practice and structured learner activities.</p></div>
                <div class="case-fact"><strong>Project contribution</strong><p>Learning-content organization, interface planning, activity structure, and project presentation.</p></div>
                <div class="case-fact"><strong>Process</strong><p>Organized activities into understandable categories and documented the interface through the supplied project boards.</p></div>
                <div class="case-fact"><strong>Deliverables</strong><p>Mobile learning screens, activity categories, educational content structure, and project documentation.</p></div>
              </div>
              <!-- TODO: Confirm the exact technology stack and individual team responsibilities for SpeakSmart. -->
              <div class="chip-row"><span class="chip">Mobile learning</span><span class="chip">Instructional design</span><span class="chip">Content structure</span><span class="chip">Learning tools</span></div>
              <p class="case-result"><strong>Documented output:</strong> five supplied project images presented through an accessible gallery with a verified public Facebook post.</p>
              <div class="case-actions"><button class="button gallery-trigger" type="button" data-project="speaksmart">View project gallery</button><a class="button ghost" href="https://www.facebook.com/share/p/19BCw8yBow/" target="_blank" rel="noopener noreferrer">View original post ↗</a></div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="capabilities" aria-labelledby="capabilities-title">
      <div class="container">
        <div class="section-label">Capabilities</div>
        <h2 class="section-heading" id="capabilities-title">A connected toolkit for building and supporting <span class="violet">digital work.</span></h2>

        <div class="capability-layout reveal">
          <article class="capability-overview panel"><h3>Tools support the outcome.</h3><p>I select tools according to the work required—not simply because they are popular. The goal is a clear, maintainable, and useful solution.</p><div class="capability-note">This portfolio emphasizes demonstrated project work, thoughtful structure, and reliable execution over unsupported skill percentages.</div></article>
          <div class="tool-groups">
            <article class="tool-group panel"><div><h3>Development</h3><small>Web and database tools</small></div><div class="tool-list"><span class="tool"><img src="images/html5-icon.png" width="260" height="260" loading="lazy" alt="">HTML</span><span class="tool"><img src="images/css3-icon.png" width="260" height="260" loading="lazy" alt="">CSS</span><span class="tool"><img src="images/javascript-icon.png" width="260" height="260" loading="lazy" alt="">JavaScript</span><span class="tool"><img src="images/typescript-icon.png" width="260" height="260" loading="lazy" alt="">TypeScript</span><span class="tool">React</span><span class="tool">Node.js</span><span class="tool">Database</span></div></article>
            <article class="tool-group panel"><div><h3>Digital productivity</h3><small>Systems and operations</small></div><div class="tool-list"><span class="tool">Google Workspace</span><span class="tool">Microsoft 365</span><span class="tool">AI productivity tools</span><span class="tool">Workflow automation</span><span class="tool">Documentation</span><span class="tool">Research</span></div></article>
            <article class="tool-group panel"><div><h3>Learning solutions</h3><small>Education and content</small></div><div class="tool-list"><span class="tool">Instructional design</span><span class="tool">Digital learning materials</span><span class="tool">Curriculum support</span><span class="tool">Mobile learning</span><span class="tool">Content development</span></div></article>
            <article class="tool-group panel"><div><h3>Business support</h3><small>Remote delivery</small></div><div class="tool-list"><span class="tool">Virtual assistance</span><span class="tool">Task coordination</span><span class="tool">File organization</span><span class="tool">Presentation support</span><span class="tool">Progress reporting</span></div></article>
          </div>
        </div>

        <div class="workflow-heading reveal"><div class="section-label">Working process</div><h3 class="section-heading">A practical path from request to <span class="cyan">reliable delivery.</span></h3></div>
        <div class="workflow-grid reveal">
          <article class="workflow-step panel"><span class="workflow-number">01</span><h3>Discover</h3><p>I clarify the audience, goal, priorities, constraints, available materials, and definition of success.</p></article>
          <article class="workflow-step panel"><span class="workflow-number">02</span><h3>Organize</h3><p>I structure the work, identify the necessary tools, define milestones, and document the plan.</p></article>
          <article class="workflow-step panel"><span class="workflow-number">03</span><h3>Execute</h3><p>I complete the agreed tasks carefully, communicate progress, and keep files and decisions organized.</p></article>
          <article class="workflow-step panel"><span class="workflow-number">04</span><h3>Report &amp; improve</h3><p>I summarize completed work, document next steps, and identify practical improvements when appropriate.</p></article>
        </div>
      </div>
    </section>

    <section class="section" id="experience" aria-labelledby="experience-title">
      <div class="container">
        <div class="experience-intro reveal">
          <div><div class="section-label">Professional experience areas</div><h2 class="section-heading" id="experience-title">Experience across <span class="cyan">technology,</span> <span class="violet">education,</span> and innovation.</h2></div>
          <p class="section-intro">A multidisciplinary background supporting technical execution, educational content, and organized digital operations.</p>
        </div>
        <div class="experience-grid reveal">
          <article class="experience-card panel"><small>Information technology</small><h3>IT Specialist</h3><ul><li>Technology implementation</li><li>System and platform support</li><li>Digital solutions development</li></ul></article>
          <article class="experience-card panel"><small>Education and learning</small><h3>Educator / Curriculum Consultant</h3><ul><li>Curriculum development support</li><li>Digital learning materials</li><li>Educational technology integration</li></ul></article>
          <article class="experience-card panel"><small>Consulting and operations</small><h3>Digital Solutions Specialist</h3><ul><li>Website development</li><li>Workflow improvement</li><li>AI productivity solutions</li></ul></article>
        </div>
        <div class="commitment reveal"><strong>Professional commitment</strong><p>I provide organized, accurate, and dependable support while respecting project requirements, confidentiality, documented procedures, and agreed deadlines.</p></div>
      </div>
    </section>

    <section class="section" id="contact" aria-labelledby="contact-title">
      <div class="container">
        <div class="contact-shell panel reveal">
          <div>
            <div class="section-label">Let’s work together</div>
            <h2 id="contact-title">Have a project that needs <span class="cyan">clear digital</span> <span class="violet">direction?</span></h2>
            <p>Share the challenge, the desired result, and your current setup. I can help turn it into a more organized, usable, and professional solution.</p>
            <div class="button-row"><a class="button primary" href="mailto:ronnel.labata@gmail.com?subject=Project%20Inquiry%20for%20Ronnel%20Labata">Email Ronnel ↗</a><a class="button ghost" href="https://www.facebook.com/ronnel.labata/" target="_blank" rel="noopener noreferrer">Connect on Facebook</a></div>
          </div>
          <aside class="contact-card panel" aria-label="Verified contact details">
            <h3>Contact channels</h3>
            <div class="contact-list">
              <div class="contact-item"><b>Email</b><a href="mailto:ronnel.labata@gmail.com">ronnel.labata@gmail.com</a></div>
              <div class="contact-item"><b>Profile</b><a href="https://www.facebook.com/ronnel.labata/" target="_blank" rel="noopener noreferrer">facebook.com/ronnel.labata</a></div>
              <div class="contact-item"><b>Location</b><span>Norala, Philippines</span></div>
              <div class="contact-item"><b>Time zone</b><span>Philippine Time, GMT+8</span></div>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner"><div><strong>Ronnel Labata</strong><span class="footer-role">IT, Education &amp; Digital Solutions</span></div><div>© <span id="current-year"></span> Ronnel Labata. <a href="#home">Back to top ↑</a></div></div>
  </footer>

  <div class="gallery-modal" id="project-gallery" role="dialog" aria-modal="true" aria-labelledby="gallery-title" aria-describedby="gallery-description" hidden>
    <div class="gallery-dialog">
      <header class="gallery-head"><div><small id="gallery-type">Project gallery</small><h2 id="gallery-title">Project title</h2></div><button class="gallery-close" type="button" aria-label="Close project gallery">×</button></header>
      <div class="gallery-stage">
        <button class="gallery-nav gallery-previous" type="button" aria-label="Previous project image">‹</button>
        <figure><img id="gallery-image" src="images/genspe-1.png" width="1514" height="1039" alt="GenSpe application project board"><figcaption id="gallery-counter" aria-live="polite"></figcaption></figure>
        <button class="gallery-nav gallery-next" type="button" aria-label="Next project image">›</button>
      </div>
      <footer class="gallery-foot"><p id="gallery-description"></p><a id="gallery-link" href="#" target="_blank" rel="noopener noreferrer">View original project post ↗</a></footer>
    </div>
  </div>

  <script>
    (() => {
      const menuButton = document.querySelector('.menu-toggle');
      const navigation = document.querySelector('.nav-links');
      const navLinks = [...navigation.querySelectorAll('a')];

      const closeMenu = () => {
        navigation.classList.remove('open');
        menuButton.setAttribute('aria-expanded', 'false');
        menuButton.setAttribute('aria-label', 'Open navigation menu');
      };

      menuButton.addEventListener('click', () => {
        const isOpen = navigation.classList.toggle('open');
        menuButton.setAttribute('aria-expanded', String(isOpen));
        menuButton.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
      });
      navLinks.forEach(link => link.addEventListener('click', closeMenu));

      const sections = [...document.querySelectorAll('main section[id]')];
      if ('IntersectionObserver' in window) {
        const sectionObserver = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            navLinks.forEach(link => link.classList.toggle('active', link.getAttribute('href') === '#' + entry.target.id));
          });
        }, { rootMargin: '-34% 0px -58% 0px' });
        sections.forEach(section => sectionObserver.observe(section));

        const revealObserver = new IntersectionObserver((entries, controller) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('visible');
            controller.unobserve(entry.target);
          });
        }, { threshold: .1 });
        document.querySelectorAll('.reveal').forEach(element => revealObserver.observe(element));
      } else {
        document.querySelectorAll('.reveal').forEach(element => element.classList.add('visible'));
      }

      document.getElementById('current-year').textContent = new Date().getFullYear();

      const projects = {
        genspe: {
          title: 'GenSpe Learning Application',
          type: 'Academic project',
          description: 'Supplied interface screens documenting the GenSpe educational mobile application concept.',
          link: 'https://www.facebook.com/share/p/1BW5AodikY/',
          images: [
            { src: 'images/genspe-1.png', alt: 'GenSpe application project board showing mobile learning interface screens' },
            { src: 'images/genspe-2.png', alt: 'GenSpe application project board showing learning content and interface flow' },
            { src: 'images/genspe-3.png', alt: 'GenSpe application project board showing additional educational app screens' }
          ]
        },
        speaksmart: {
          title: 'SpeakSmart Mobile Learning Application',
          type: 'Academic project',
          description: 'Supplied project boards documenting SpeakSmart communication and vocabulary learning activities.',
          link: 'https://www.facebook.com/share/p/19BCw8yBow/',
          images: [
            { src: 'images/speaksmart-1.png', alt: 'SpeakSmart project board showing the learning application interface' },
            { src: 'images/speaksmart-2.png', alt: 'SpeakSmart project board showing communication learning activities' },
            { src: 'images/speaksmart-3.png', alt: 'SpeakSmart project board showing vocabulary and guided activity screens' },
            { src: 'images/speaksmart-4.png', alt: 'SpeakSmart project board showing additional learner interface screens' },
            { src: 'images/speaksmart-5.png', alt: 'SpeakSmart project board showing the complete mobile application presentation' }
          ]
        }
      };

      const modal = document.getElementById('project-gallery');
      const dialog = modal.querySelector('.gallery-dialog');
      const closeButton = modal.querySelector('.gallery-close');
      const previousButton = modal.querySelector('.gallery-previous');
      const nextButton = modal.querySelector('.gallery-next');
      const galleryImage = document.getElementById('gallery-image');
      const galleryTitle = document.getElementById('gallery-title');
      const galleryType = document.getElementById('gallery-type');
      const galleryCounter = document.getElementById('gallery-counter');
      const galleryDescription = document.getElementById('gallery-description');
      const galleryLink = document.getElementById('gallery-link');
      let activeProject = null;
      let activeIndex = 0;
      let previousFocus = null;

      const updateGallery = () => {
        const project = projects[activeProject];
        const image = project.images[activeIndex];
        galleryImage.src = image.src;
        galleryImage.alt = image.alt;
        galleryTitle.textContent = project.title;
        galleryType.textContent = project.type;
        galleryDescription.textContent = project.description;
        galleryCounter.textContent = 'Image ' + (activeIndex + 1) + ' of ' + project.images.length;
        galleryLink.href = project.link;
      };

      const showPrevious = () => {
        const length = projects[activeProject].images.length;
        activeIndex = (activeIndex - 1 + length) % length;
        updateGallery();
      };

      const showNext = () => {
        const length = projects[activeProject].images.length;
        activeIndex = (activeIndex + 1) % length;
        updateGallery();
      };

      const openGallery = (key, trigger) => {
        if (!projects[key]) return;
        activeProject = key;
        activeIndex = 0;
        previousFocus = trigger;
        updateGallery();
        modal.hidden = false;
        document.body.classList.add('modal-open');
        closeButton.focus();
      };

      const closeGallery = () => {
        modal.hidden = true;
        document.body.classList.remove('modal-open');
        activeProject = null;
        if (previousFocus) previousFocus.focus();
      };

      document.querySelectorAll('.gallery-trigger').forEach(trigger => trigger.addEventListener('click', () => openGallery(trigger.dataset.project, trigger)));
      closeButton.addEventListener('click', closeGallery);
      previousButton.addEventListener('click', showPrevious);
      nextButton.addEventListener('click', showNext);
      modal.addEventListener('click', event => {
        if (!dialog.contains(event.target)) closeGallery();
      });

      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && navigation.classList.contains('open')) {
          closeMenu();
          menuButton.focus();
        }
        if (modal.hidden) return;
        if (event.key === 'Escape') closeGallery();
        if (event.key === 'ArrowLeft') showPrevious();
        if (event.key === 'ArrowRight') showNext();
        if (event.key === 'Tab') {
          const focusable = [...modal.querySelectorAll('button:not([disabled]),a[href]')];
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        }
      });
    })();
  </script>
</body>
</html>
